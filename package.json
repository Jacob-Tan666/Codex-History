{
  "name": "codex-history-skill",
  "version": "0.4.3",
  "description": "A local OpenAI Codex history manager with a CLI and visual dashboard for managing Codex sessions.",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "keywords": [
    "codex",
    "openai-codex",
    "codex-cli",
    "codex-desktop",
    "codex-history",
    "codex-session-manager",
    "skill",
    "history",
    "session",
    "session-manager",
    "conversation-history",
    "history-manager",
    "local-dashboard",
    "web-dashboard",
    "archive",
    "export"
  ],
  "files": [
    "SKILL.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "start-ui.cmd",
    "start-ui.sh",
    "scripts",
    "public"
  ],
  "bin": {
    "codex-history": "scripts/history-cli.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test test/unit-skill-history-cli.test.js",
    "cli": "node scripts/history-cli.js",
    "ui": "node scripts/start-ui.js",
    "ui:raw": "node scripts/history-cli.js ui",
    "list": "node scripts/history-cli.js list --source all --format table",
    "check": "node --check scripts/history-cli.js && node --check scripts/history-core.js && node --check scripts/ui-server.js && node --check scripts/start-ui.js && node --check public/app.js",
    "pack:skill": "node scripts/pack-skill.js"
  }
}
